# Fastshop - Variáveis de ambiente (produção)
# Copie este arquivo para ".env" e preencha os valores.

# PostgreSQL
POSTGRES_USER=fastshop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=fastshop

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod

# JWT
JWT_SECRET=please_generate_a_long_random_secret
JWT_EXPIRATION=86400

# App port (opcional; padrão 8080)
APP_HTTP_PORT=8080

# Flags de reset do admin (dev only; mantenha desativadas em produção)
RESET_ADMIN_PASSWORD=false
RESET_ADMIN_USERNAME=
RESET_ADMIN_PLAIN_PASSWORD=