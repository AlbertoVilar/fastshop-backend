# FastShop local/production environment variables.
# Copy to .env and replace every example value before starting the stack.

POSTGRES_USER=fastshop
POSTGRES_PASSWORD=change_me_with_a_strong_local_password
POSTGRES_DB=fastshop

SPRING_PROFILES_ACTIVE=prod

# Generate a long random value. Never reuse it between environments.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=3600000

# pgAdmin is for local development only.
PGADMIN_DEFAULT_EMAIL=admin@fastshop.local
PGADMIN_DEFAULT_PASSWORD=change_me_with_a_strong_local_password

# Disabled by default. Use only temporarily in a local environment.
RESET_ADMIN_PASSWORD=false
RESET_ADMIN_USERNAME=
RESET_ADMIN_PLAIN_PASSWORD=
